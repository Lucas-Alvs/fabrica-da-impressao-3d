# ─────────────────────────────────────────────────────────────
# Fábrica Da Impressão 3D — variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento)
# e cadastre as mesmas chaves na Vercel (produção).
# ─────────────────────────────────────────────────────────────

# Banco de dados
# Desenvolvimento (SQLite, sem instalar nada):
DATABASE_URL="sqlite:./data/fabrica.sqlite"
# Produção (PostgreSQL — Neon, Supabase, Railway, RDS...):
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo usado para assinar a sessão do painel (obrigatório em produção)
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"

# Credenciais iniciais do painel administrativo
ADMIN_EMAIL="admin@fabrica3d.com"
ADMIN_PASSWORD="fabrica123"

# Nome exibido no sistema e no PDF (pode ser alterado nas Configurações)
NEXT_PUBLIC_COMPANY_NAME="Fábrica Da Impressão 3D"
